---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a
  href={href}
  class="gradient-border relative inline-flex w-auto items-center justify-center rounded-full bg-[#212121] px-4 py-2 text-xs font-semibold tracking-wide text-white uppercase"
>
  {label}
</a>
