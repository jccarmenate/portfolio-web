---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { cv, otherLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const email = profile.contact.email;
const other = cv[otherLang(lang)];
---
<section id="contact" aria-labelledby="contact-title" class="container-page pb-20 md:pb-28">
  <div class="reveal-scroll relative isolate overflow-hidden rounded-3xl bg-neutral-950 px-6 py-14 text-center ring-1 ring-white/10 sm:px-12 md:py-20">
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-[radial-gradient(50%_80%_at_50%_0%,--alpha(var(--color-emerald-400)/22%),transparent)]"
    >
    </div>
    <p class="font-mono text-eyebrow text-emerald-400 uppercase">{dict.contact.eyebrow}</p>
    <h2 id="contact-title" class="mt-3 text-title text-balance text-white">{dict.contact.title}</h2>
    <p class="mx-auto mt-4 max-w-[52ch] text-neutral-400">{dict.contact.body}</p>

    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href={`mailto:${email}`}
        class="font-mono text-lg break-all text-white underline decoration-emerald-400/60 decoration-2 underline-offset-8 transition hover:decoration-emerald-400 sm:text-xl"
      >
        {email}
      </a>
      <button
        type="button"
        data-copy={email}
        class="inline-flex h-9 items-center gap-1.5 rounded-full border border-white/15 px-3 font-mono text-xs text-neutral-300 transition hover:bg-white/5"
      >
        <Icon name="copy" class="size-3.5" />
        <span data-copy-label>{dict.contact.copy}</span>
      </button>
      <span class="sr-only" aria-live="polite" data-copy-status data-copied={dict.contact.copied}></span>
    </div>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button href={cv[lang].href} download={cv[lang].download} icon="download">{dict.contact.cv}</Button>
      <Button href={profile.contact.github} variant="onDark" icon="arrow-up-right" external>
        GitHub<span class="sr-only"> {dict.a11y.newTab}</span>
      </Button>
      {profile.contact.linkedin && (
        <Button href={profile.contact.linkedin} variant="onDark" icon="arrow-up-right" external>
          LinkedIn<span class="sr-only"> {dict.a11y.newTab}</span>
        </Button>
      )}
    </div>
    <p class="mt-6 text-sm">
      <a href={other.href} download={other.download} class="text-neutral-400 underline-offset-4 hover:text-white hover:underline">
        {dict.contact.otherCv}
      </a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    const original = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      const copied = status?.dataset.copied ?? '';
      if (label) label.textContent = copied;
      if (status) status.textContent = copied;
      setTimeout(() => {
        if (label) label.textContent = original;
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
