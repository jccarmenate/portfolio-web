---
import { profile } from '../data/profile';
---
<div class="relative mx-auto w-full max-w-[280px]">
  <div class="absolute -inset-3 rounded-2xl border-2 border-dashed border-emerald-400/70"></div>
  <div class="absolute -right-3 -bottom-3 -z-10 h-full w-full rounded-2xl bg-gradient-to-r from-white via-emerald-100 to-white dark:from-neutral-950 dark:via-emerald-950/30 dark:to-neutral-950"></div>
  <div class="relative z-10 overflow-hidden rounded-xl border border-neutral-300 bg-white shadow-sm dark:border-neutral-700 dark:bg-neutral-950">
    <div class="flex items-center gap-1.5 border-b border-neutral-200 px-4 py-2.5 dark:border-neutral-800">
      <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
      <span class="ml-2 truncate text-[0.65rem] text-neutral-400 dark:text-neutral-500">whoami.sh</span>
    </div>
    <div class="px-4 py-5 font-mono text-xs leading-relaxed">
      <p><span class="text-emerald-500">$</span> <span class="text-neutral-700 dark:text-neutral-300">whoami</span></p>
      <p class="mt-1 font-semibold text-neutral-900 dark:text-neutral-100">{profile.name}</p>
      <p class="mt-3"><span class="text-emerald-500">$</span> <span class="text-neutral-700 dark:text-neutral-300">role --current</span></p>
      <p class="mt-1 gradient-text font-semibold">Backend / AI Engineer</p>
    </div>
  </div>
</div>
