---
---
<div class="relative mx-auto w-full max-w-[280px]">
  <div class="absolute -inset-3 rounded-2xl border-2 border-dashed border-emerald-400/70"></div>
  <div class="absolute -right-3 -bottom-3 -z-10 h-full w-full rounded-2xl bg-gradient-to-r from-white via-emerald-100 to-white dark:from-neutral-950 dark:via-emerald-950/30 dark:to-neutral-950"></div>
  <div class="relative z-10 overflow-hidden rounded-xl border border-neutral-700 bg-neutral-950 shadow-sm">
    <div class="flex items-center gap-1.5 border-b border-neutral-800 px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
      <span class="ml-2 truncate text-[0.65rem] text-neutral-500">rain.sh</span>
    </div>
    <div class="relative h-[170px]">
      <canvas id="rain-canvas" class="block h-full w-full" aria-hidden="true"></canvas>
    </div>
  </div>
</div>

<script>
  const canvas = document.getElementById('rain-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0;
    let h = 0;

    interface Drop {
      x: number;
      y: number;
      speed: number;
    }

    const PITCH = 20;
    const SIZE = 13;
    const LEN = 7;
    const SPEED = 0.35;
    const ALPHA = 0.22;
    const COLOR = 'rgba(90,200,160,ALPHA)';

    const chars = '01アイウエオカキクケコ';
    let drops: Drop[] = [];

    function makeDrops(): Drop[] {
      const cols = Math.ceil(w / PITCH) + 1;
      const cycle = h + 2 * LEN * SIZE;
      const next: Drop[] = [];
      for (let i = 0; i < cols; i++) {
        next.push({
          x: i * PITCH + PITCH / 2,
          y: Math.random() * cycle - LEN * SIZE,
          speed: SPEED * (0.7 + Math.random() * 0.6),
        });
      }
      return next;
    }

    function resize() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      drops = makeDrops();
    }
    resize();
    window.addEventListener('resize', resize);

    function frame() {
      if (!ctx) return;
      ctx.fillStyle = 'rgba(10,10,10,0.4)';
      ctx.fillRect(0, 0, w, h);
      ctx.font = SIZE + 'px monospace';
      ctx.textAlign = 'center';
      drops.forEach((d) => {
        for (let k = 0; k < LEN; k++) {
          const cy = d.y - k * SIZE;
          if (cy < -SIZE || cy > h + SIZE) continue;
          const ch = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillStyle = COLOR.replace('ALPHA', String(ALPHA * (1 - k / LEN)));
          ctx.fillText(ch, d.x, cy);
        }
        d.y += d.speed;
        if (d.y - LEN * SIZE > h) d.y = -LEN * SIZE - Math.random() * h * 0.4;
      });
      requestAnimationFrame(frame);
    }

    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
      requestAnimationFrame(frame);
    } else if (ctx) {
      ctx.fillStyle = '#0a0a0a';
      ctx.fillRect(0, 0, w, h);
    }
  }
</script>
