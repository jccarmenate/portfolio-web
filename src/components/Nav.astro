---
import Icon from './Icon.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { cv, paths, t, type Lang, type Localized } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Localized;
  current?: 'home' | 'projects';
}
const { lang, alternates, current } = Astro.props;
const dict = t(lang);
const home = paths.home[lang];

const links = [
  { href: paths.projects[lang], label: dict.nav.projects, current: current === 'projects' },
  { href: `${home}#experience`, label: dict.nav.experience },
  { href: `${home}#services`, label: dict.nav.services },
  { href: `${home}#contact`, label: dict.nav.contact },
];
const iconButton =
  'grid size-9 place-items-center rounded-md text-ink-muted transition hover:bg-surface hover:text-ink';
---
<header class="sticky top-0 z-50 border-b border-line/70 bg-canvas/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={home} aria-label={dict.a11y.home} class="font-mono text-[15px] font-semibold tracking-tight text-ink">
      <span class="text-ink-muted">&lt;</span>JC<span class="text-accent-ink">/&gt;</span>
    </a>

    <nav aria-label={dict.a11y.mainNav} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              class="rounded-md px-3 py-2 text-sm text-ink-muted transition hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <div class="hidden items-center gap-1 md:flex">
        <LangToggle lang={lang} alternates={alternates} />
        <a href={profile.contact.github} target="_blank" rel="noopener" class={iconButton}>
          <Icon name="github" class="size-[18px]" />
          <span class="sr-only">GitHub {dict.a11y.newTab}</span>
        </a>
        <ThemeToggle lang={lang} />
      </div>

      <a
        href={cv[lang].href}
        download={cv[lang].download}
        aria-label={dict.nav.cvLabel}
        class="group ml-1 inline-flex h-9 items-center gap-1.5 rounded-full border border-line px-3.5 text-sm font-medium text-ink transition hover:border-ink/30 hover:bg-surface"
      >
        {dict.nav.cv}
        <Icon name="download" class="size-3.5 transition-transform group-hover:translate-y-0.5 motion-reduce:transition-none" />
      </a>

      <button
        type="button"
        id="nav-toggle"
        aria-controls="nav-panel"
        aria-expanded="false"
        aria-label={dict.a11y.openMenu}
        data-label-open={dict.a11y.openMenu}
        data-label-close={dict.a11y.closeMenu}
        class="group grid size-9 place-items-center rounded-md text-ink md:hidden"
      >
        <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
        <Icon name="close" class="hidden size-5 group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <div
    id="nav-panel"
    hidden
    class="absolute inset-x-0 top-full border-b border-line bg-canvas shadow-lg shadow-neutral-950/5 md:hidden"
  >
    <nav aria-label={dict.a11y.mainNav}>
      <ul class="py-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              class="block px-5 py-3.5 text-base text-ink hover:bg-surface aria-[current=page]:font-semibold"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2 border-t border-line px-5 py-4">
      <LangToggle lang={lang} alternates={alternates} />
      <a href={profile.contact.github} target="_blank" rel="noopener" class={iconButton}>
        <Icon name="github" class="size-[18px]" />
        <span class="sr-only">GitHub {dict.a11y.newTab}</span>
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('nav-panel');

  if (toggle && panel) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, focusFirst = false) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      if (open && focusFirst) panel.querySelector<HTMLElement>('a, button')?.focus();
    };

    toggle.addEventListener('click', (event) => {
      // Keyboard activation reports detail 0: move focus into the panel then.
      setOpen(!isOpen(), (event as MouseEvent).detail === 0);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (isOpen() && !panel.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a[href*="#"]')) setOpen(false);
    });

    matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
