---
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/services';
import { projectBySlug } from '../data/projects';
import { projectHref } from '../lib/links';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---
<section id="services" aria-labelledby="services-title" class="container-page py-20 md:py-28">
  <SectionHeading id="services-title" title={dict.sections.services} intro={dict.sections.servicesIntro} />
  <dl class="divide-y divide-line border-y border-line">
    {services.map((service) => {
      const evidence = service.evidence.map((slug) => projectBySlug(slug)!).filter(Boolean);
      return (
        <div class="grid gap-2 py-6 md:grid-cols-12 md:gap-10">
          <dt class="font-semibold text-ink md:col-span-4">{service.title[lang]}</dt>
          <dd class="text-[15px] leading-relaxed text-ink-muted md:col-span-8">
            <p>{service.description[lang]}</p>
            {evidence.length > 0 && (
              <p class="mt-2 font-mono text-xs">
                <span class="text-ink-muted">{dict.sections.servicesEvidence}</span>{' '}
                {evidence.map((project, i) => (
                  <Fragment>
                    <a href={projectHref(project, lang)} class="text-accent-ink underline-offset-4 hover:underline">
                      {project.title}
                    </a>
                    {i < evidence.length - 1 && <span aria-hidden="true" class="text-ink-muted"> · </span>}
                  </Fragment>
                ))}
              </p>
            )}
          </dd>
        </div>
      );
    })}
  </dl>
</section>
