---
import SectionHeading from './SectionHeading.astro';
import { principles } from '../data/approach';
import { projectBySlug } from '../data/projects';
import { projectHref } from '../lib/links';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---
<section id="approach" aria-labelledby="approach-title" class="container-page pb-20 md:pb-28">
  <SectionHeading id="approach-title" title={dict.sections.approach} intro={dict.sections.approachIntro} />
  <ul class="grid gap-x-10 gap-y-12 md:grid-cols-3 md:grid-rows-[auto_auto_1fr_auto] md:gap-y-0">
    {principles.map((principle, i) => {
      const evidence = principle.evidence.map((slug) => projectBySlug(slug)!).filter(Boolean);
      return (
        <li class="reveal-scroll border-t border-line pt-6 md:row-span-4 md:grid md:grid-rows-subgrid md:gap-y-0" style={`--i: ${i}`}>
          <p class="font-mono text-eyebrow text-accent-ink uppercase">{principle.tag[lang]}</p>
          <h3 class="mt-3 text-lg font-semibold tracking-tight text-balance text-ink">{principle.title[lang]}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{principle.body[lang]}</p>
          <p class="mt-4 font-mono text-xs">
            <span class="text-ink-muted">{dict.sections.servicesEvidence}</span>{' '}
            {evidence.map((project, j) => (
              <Fragment>
                <a href={projectHref(project, lang)} class="text-accent-ink underline-offset-4 hover:underline">
                  {project.title}
                </a>
                {j < evidence.length - 1 && <span aria-hidden="true" class="text-ink-muted"> · </span>}
              </Fragment>
            ))}
          </p>
        </li>
      );
    })}
  </ul>
</section>
