---
import { gradientForIndex } from '../lib/gradient';
import { getInitials } from '../lib/getInitials';

interface Props {
  title: string;
  index: number;
  image?: string;
}
const { title, index, image } = Astro.props;
const [from, to] = gradientForIndex(index);
const initials = getInitials(title);
---
{
  image ? (
    <img
      src={image}
      alt={title}
      class="aspect-video w-full rounded-lg object-cover object-top"
      loading="lazy"
    />
  ) : (
    <div
      class="flex aspect-video w-full items-center justify-center rounded-lg text-2xl font-bold text-white/90"
      style={`background-image: linear-gradient(135deg, ${from}, ${to})`}
    >
      {initials}
    </div>
  )
}
