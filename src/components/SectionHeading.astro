---
interface Props {
  id: string;
  title: string;
  intro?: string;
  level?: 'h1' | 'h2';
}
const { id, title, intro, level: Heading = 'h2' } = Astro.props;
---
<div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <Heading id={id} class="text-title text-ink">{title}</Heading>
    {intro && <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-ink-muted">{intro}</p>}
  </div>
  <slot name="aside" />
</div>
