---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---
<section id="experience" aria-labelledby="experience-title" class="border-y border-line bg-surface/50">
  <div class="container-page py-20 md:py-28">
    <SectionHeading id="experience-title" title={dict.sections.experience} />
    <ol class="space-y-12">
      {experience.map((entry, i) => (
        <li class:list={['reveal-scroll grid gap-4 md:grid-cols-12 md:gap-10', i > 0 && 'border-t border-line pt-12']}>
          <div class="font-mono text-[13px] leading-relaxed text-ink-muted md:col-span-3">
            <p>{entry.dateRange[lang]}</p>
            {entry.dateNote && <p>{entry.dateNote[lang]}</p>}
          </div>
          <div class="md:col-span-9">
            <p class="font-mono text-eyebrow text-accent-ink uppercase">
              {dict.experience[entry.kind]}
            </p>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-ink">{entry.title[lang]}</h3>
            <p class="mt-1 text-sm text-ink-muted">
              {entry.orgUrl ? (
                <a href={entry.orgUrl} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-ink">
                  {entry.org[lang]}
                </a>
              ) : (
                entry.org[lang]
              )}
              {entry.location && <span> · {entry.location[lang]}</span>}
            </p>
            <ul class="mt-4 max-w-[68ch] space-y-2.5 text-[15px] leading-relaxed text-ink-muted">
              {entry.bullets[lang].map((bullet) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-accent"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            {entry.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {entry.tags.map((tag) => <li class="chip">{tag}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
