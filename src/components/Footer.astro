---
import { profile } from '../data/profile';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-2 py-8 font-mono text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      <span aria-hidden="true">&lt;JC/&gt; · </span>{profile.name} · {year}
    </p>
    <p>{t(lang).footer.builtWith}</p>
  </div>
</footer>
