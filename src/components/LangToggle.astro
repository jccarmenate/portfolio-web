---
import { langs, t, type Lang, type Localized } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Localized;
}
const { lang, alternates } = Astro.props;
---
<div class="inline-flex rounded-md border border-line p-0.5 font-mono text-[11px]">
  {langs.map((l) =>
    l === lang ? (
      <span class="rounded-[5px] bg-surface px-1.5 py-0.5 text-ink uppercase" aria-current="true">{l}</span>
    ) : (
      <a
        href={alternates[l]}
        hreflang={l}
        lang={l}
        data-lang-switch
        class="px-1.5 py-0.5 text-ink-muted uppercase hover:text-ink"
      >
        {l}<span class="sr-only"> {t(l).a11y.switchLang}</span>
      </a>
    ),
  )}
</div>

<script>
  // Keep the section the reader was looking at (ids match across locales).
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
    a.addEventListener('click', () => {
      if (location.hash) a.hash = location.hash;
    });
  });
</script>
