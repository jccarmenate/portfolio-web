---
import ProjectPreview from './ProjectPreview.astro';
import ProjectTitle from './ProjectTitle.astro';
import ProjectChips from './ProjectChips.astro';
import ProjectLinks from './ProjectLinks.astro';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}

const { project, lang, reverse = false, headingLevel = 'h3', priority = false } = Astro.props;
---
<article
  id={project.slug}
  class="group relative isolate grid rounded-2xl border border-line bg-surface/60 transition duration-300 focus-within:-translate-y-0.5 focus-within:border-emerald-500/40 hover:-translate-y-0.5 hover:border-emerald-500/40 motion-reduce:transform-none md:grid-cols-12"
>
  <div class:list={['p-3 md:col-span-7 md:p-4', reverse && 'md:order-2']}>
    <ProjectPreview project={project} lang={lang} variant="featured" priority={priority} />
  </div>
  <div class="flex flex-col px-5 pt-3 pb-6 md:col-span-5 md:p-8">
    <ProjectTitle project={project} lang={lang} level={headingLevel} class="text-xl md:text-2xl" />
    <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">{project.summary[lang]}</p>
    {project.highlights && (
      <ul class="mt-4 hidden space-y-2 text-sm leading-6 text-ink-muted md:block">
        {project.highlights[lang].map((item) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent-ink">▹</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
    <ProjectChips project={project} lang={lang} class="mt-5" />
    <ProjectLinks project={project} lang={lang} />
  </div>
</article>
