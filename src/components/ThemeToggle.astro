---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t(lang).a11y.darkMode}
  class="grid size-9 place-items-center rounded-md text-ink-muted transition hover:bg-surface hover:text-ink"
>
  <Icon name="moon" class="size-[18px] dark:hidden" />
  <Icon name="sun" class="hidden size-[18px] dark:block" />
</button>

<script>
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function sync() {
    const dark = root.classList.contains('dark');
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(dark)));
    meta?.setAttribute('content', dark ? '#0d1110' : '#ffffff');
  }

  sync();
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
      sync();
    }),
  );
</script>
