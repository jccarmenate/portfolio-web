---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ContactSection from '../components/ContactSection.astro';
import { projects, repoUrl, type Project } from '../data/projects';
import { paths, t, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const { meta } = t(lang);
const site = Astro.site!;

const studies = projects.filter((p) => p.caseStudy);
const next = studies[(studies.indexOf(project) + 1) % studies.length];

// Social preview cropped from the project's real cover (1.91:1, never upscaled).
const cover = project.cover.kind === 'screenshot' ? project.cover.src : undefined;
const ogWidth = cover ? Math.min(1200, cover.width) : 0;
const ogHeight = Math.round((ogWidth * 630) / 1200);
const og = cover
  ? await getImage({ src: cover, width: ogWidth, height: ogHeight, fit: 'cover', position: 'top', format: 'png' })
  : undefined;
---
<BaseLayout
  lang={lang}
  title={`${project.title} — ${meta.caseStudySuffix}`}
  description={project.caseStudy!.description[lang]}
  alternates={paths.project(project.slug)}
  current="projects"
  ogType="article"
  ogImage={og?.src}
  ogImageAlt={og ? project.cover.alt[lang] : undefined}
  ogImageWidth={og ? ogWidth : undefined}
  ogImageHeight={og ? ogHeight : undefined}
  structuredData={[
    {
      '@type': 'SoftwareSourceCode',
      name: project.title,
      description: project.caseStudy!.description[lang],
      url: new URL(paths.project(project.slug)[lang], site).href,
      codeRepository: repoUrl(project),
      keywords: project.stack.join(', '),
      inLanguage: lang,
      author: { '@id': new URL('/#person', site).href },
    },
  ]}
>
  <CaseStudy project={project} next={next} lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
